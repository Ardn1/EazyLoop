<Window x:Class="EazyLoop.DrumWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:EazyLoop"
 Title="SimpleDrums · EazyLoop" Width="1010" Height="610" MinWidth="720" MinHeight="480"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True" FontFamily="Segoe UI" FontSize="13"
 Background="{DynamicResource Background}" Foreground="{DynamicResource Ink}" PreviewKeyDown="WindowKeys">
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <Button DockPanel.Dock="Right" Content="{DynamicResource 'loc:Настройки набора…'}" Click="KitClicked"/>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
    <Button x:Name="UndoButton" Style="{StaticResource HistoryButton}" Content="1" Click="UndoClicked"
     ToolTip="{DynamicResource 'loc:Отменить · Ctrl+Z'}" AutomationProperties.Name="{DynamicResource 'loc:Отменить'}"/>
    <Button x:Name="RedoButton" Style="{StaticResource HistoryButton}" Content="-1" Click="RedoClicked" Margin="4,0,0,0"
     ToolTip="{DynamicResource 'loc:Повторить · Ctrl+Y или Ctrl+Shift+Z'}" AutomationProperties.Name="{DynamicResource 'loc:Повторить'}"/>
   </StackPanel>
   <Border DockPanel.Dock="Left" Width="47" Height="39" CornerRadius="9" Background="{DynamicResource RecordPanel}" Margin="0,0,11,0">
    <TextBlock Text="DRM" FontFamily="Consolas" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource Rose}"/>
   </Border>
   <StackPanel>
    <TextBlock x:Name="TrackLabel" Text="SimpleDrums" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="KitLabel" Text="{DynamicResource 'loc:8 ударных'}" FontSize="11" Foreground="{DynamicResource Muted}"/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" Padding="9,7" Margin="0,0,0,8">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="{DynamicResource 'loc:МАСШТАБ'}" Style="{StaticResource Label}" Margin="0,0,6,0"/>
     <Slider x:Name="Zoom" Minimum="1" Maximum="8" Width="89" Value="1" ValueChanged="ViewportChanged" AutomationProperties.Name="{DynamicResource 'loc:Масштаб барабанов'}"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal">
     <Button x:Name="PlayButton" Style="{StaticResource Compact}" Width="83" Content="{DynamicResource 'loc:▶ Играть'}" Click="PlayClicked"/>
     <TextBlock Text="{DynamicResource 'loc:ШАГ'}" Style="{StaticResource Label}" Margin="13,0,6,0"/>
     <ComboBox x:Name="StepChoice" Width="78" Height="27" DisplayMemberPath="Name" SelectionChanged="StepChanged" AutomationProperties.Name="{DynamicResource 'loc:Шаг ударных'}"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
   <local:DrumGrid x:Name="Steps" AutomationProperties.Name="{DynamicResource 'loc:Шаги ударных'}"/>
  </Border>
  <Slider x:Name="Scroll" Grid.Row="3" Minimum="0" Maximum="0" Value="0" ValueChanged="ViewportChanged" Margin="144,2,0,0"
   Visibility="Collapsed" AutomationProperties.Name="{DynamicResource 'loc:Прокрутка по времени'}"/>
  <Grid Grid.Row="4" Margin="0,8,0,0">
   <TextBlock Text="{DynamicResource 'loc:Щелчок по полосе — удар. Правый щелчок — выбрать удар или настроить барабан.'}"
    Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" MaxWidth="425" HorizontalAlignment="Left"/>
   <StackPanel x:Name="HitControls" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
    <TextBlock x:Name="HitLabel" Text="{DynamicResource 'loc:Выберите удар'}" Foreground="{DynamicResource Soft}" Margin="0,0,10,0" FontSize="12"/>
    <TextBlock Text="{DynamicResource 'loc:СИЛА'}" Style="{StaticResource Label}" Margin="0,0,5,0"/>
    <Slider x:Name="HitVelocity" Minimum="1" Maximum="127" Width="92" Value="100" ValueChanged="VelocityChanged"
     SmallChange="1" LargeChange="10" AutomationProperties.Name="{DynamicResource 'loc:Сила удара'}"/>
    <TextBlock x:Name="VelocityLabel" Text="100" Width="26" TextAlignment="Right" Foreground="{DynamicResource Soft}" FontFamily="Consolas"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
