<Window x:Class="EazyLoop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:EazyLoop"
 Title="{DynamicResource 'loc:EazyLoop 0.7.10 · гитарный лупер'}" Width="1110" Height="776" MinWidth="850" MinHeight="640"
 WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
 Background="{DynamicResource Background}" Foreground="{DynamicResource Ink}"
 UseLayoutRounding="True" PreviewKeyDown="WindowKeys" Loaded="WindowLoaded" Closing="WindowClosing">
 <Window.Resources>
  <Style x:Key="HeaderPickerButton" TargetType="Button" BasedOn="{StaticResource Compact}">
   <Setter Property="Width" Value="35"/>
   <Setter Property="Height" Value="24"/>
   <Setter Property="MinHeight" Value="0"/>
   <Setter Property="Padding" Value="0"/>
  </Style>
  <Style x:Key="HeaderPickerMenu" TargetType="ContextMenu">
   <Setter Property="Placement" Value="Bottom"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ContextMenu">
      <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource StrongLine}" BorderThickness="1" CornerRadius="8" Padding="4">
       <ScrollViewer MaxHeight="394" VerticalScrollBarVisibility="Auto">
        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
       </ScrollViewer>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="HeaderPickerItem" TargetType="MenuItem">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="MenuItem">
      <Border x:Name="Item" Background="Transparent" CornerRadius="5" Padding="8,5" MinWidth="180">
       <ContentPresenter ContentSource="Header"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource AccentPanel}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid Background="{DynamicResource Background}">
  <DockPanel>
   <Border DockPanel.Dock="Top" Height="31" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
    <DockPanel Margin="27,0,30,0">
     <Menu DockPanel.Dock="Left" VerticalAlignment="Center" Background="Transparent" Foreground="{DynamicResource Ink}" IsEnabled="{Binding IsEnabled, ElementName=Workspace}">
      <MenuItem Header="{DynamicResource 'loc:_Файл'}" Padding="8,0" FontSize="12" MinHeight="25">
       <MenuItem.Template>
        <ControlTemplate TargetType="MenuItem">
         <Border x:Name="FileButton" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <Grid>
           <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
           <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Bottom"
            PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" AllowsTransparency="True">
            <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource StrongLine}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,3,0,0">
             <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
           </Popup>
          </Grid>
         </Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="FileButton" Property="Background" Value="{DynamicResource AccentPanel}"/></Trigger>
          <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="FileButton" Property="Background" Value="{DynamicResource AccentPanel}"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate>
       </MenuItem.Template>
       <MenuItem.ItemContainerStyle>
        <Style TargetType="MenuItem">
         <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
         <Setter Property="Template">
          <Setter.Value>
           <ControlTemplate TargetType="MenuItem">
            <Border x:Name="Item" Background="Transparent" CornerRadius="5" Padding="10,7" MinWidth="232">
             <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Soft}" Margin="18,0,0,0" FontSize="11"/>
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
             </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
             <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource AccentPanel}"/></Trigger>
             <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Item" Property="Opacity" Value=".48"/></Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate>
          </Setter.Value>
         </Setter>
        </Style>
       </MenuItem.ItemContainerStyle>
       <MenuItem x:Name="NewProjectItem" Header="{DynamicResource 'loc:Новый проект…'}" InputGestureText="Ctrl+N" Click="NewProjectClicked"/>
       <MenuItem x:Name="OpenProjectItem" Header="{DynamicResource 'loc:Открыть проект…'}" InputGestureText="Ctrl+O" Click="OpenProjectClicked"/>
       <MenuItem Header="{DynamicResource 'loc:Сохранить проект'}" InputGestureText="Ctrl+S" Click="SaveProjectClicked"/>
      </MenuItem>
     </Menu>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
      IsEnabled="{Binding IsEnabled, ElementName=Workspace}">
      <Button x:Name="LanguageButton" Style="{StaticResource HeaderPickerButton}" Click="HeaderPickerClicked"
       ToolTip="{DynamicResource 'loc:Язык интерфейса'}" AutomationProperties.Name="{DynamicResource 'loc:Язык интерфейса'}">
       <Button.ContextMenu>
        <ContextMenu Style="{StaticResource HeaderPickerMenu}" Opened="LanguageMenuOpened"/>
       </Button.ContextMenu>
      </Button>
      <Button x:Name="ThemeButton" Style="{StaticResource HeaderPickerButton}" Margin="5,0,0,0" Click="HeaderPickerClicked"
       ToolTip="{DynamicResource 'loc:Тема оформления'}" AutomationProperties.Name="{DynamicResource 'loc:Тема оформления'}">
       <Button.ContextMenu>
        <ContextMenu Style="{StaticResource HeaderPickerMenu}" Opened="ThemeMenuOpened">
         <ContextMenu.Resources>
          <Style TargetType="Separator">
           <Setter Property="Template">
            <Setter.Value>
             <ControlTemplate TargetType="Separator">
              <Border Height="1" Margin="6,4" Background="{DynamicResource Line}"/>
             </ControlTemplate>
            </Setter.Value>
           </Setter>
          </Style>
         </ContextMenu.Resources>
        </ContextMenu>
       </Button.ContextMenu>
       <StackPanel Orientation="Horizontal">
        <Border Width="6" Height="14" CornerRadius="2" Background="{DynamicResource Background}"
         BorderBrush="{DynamicResource StrongLine}" BorderThickness="1"/>
        <Border Width="6" Height="14" CornerRadius="2" Margin="2,0" Background="{DynamicResource Field}"
         BorderBrush="{DynamicResource StrongLine}" BorderThickness="1"/>
        <Border Width="6" Height="14" CornerRadius="2" Background="{DynamicResource Violet}"/>
       </StackPanel>
      </Button>
     </StackPanel>
     <TextBlock x:Name="ProjectStatus" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource Muted}"
      MaxWidth="310" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="ProjectLabel" Text="{DynamicResource 'loc:Без проекта'}" Margin="10,0,12,0" FontSize="12" Foreground="{DynamicResource Soft}" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
   </Border>
  <Grid x:Name="Workspace" Margin="30,12,30,0">
   <Grid.RowDefinitions>
    <RowDefinition Height="66"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="58"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="43"/>
   </Grid.RowDefinitions>

   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{DynamicResource 'loc:Гитарный лупер'}">
     <Border Width="43" Height="43" CornerRadius="12" Background="{DynamicResource AccentPanel}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1">
      <Path Width="24" Height="21" Stretch="Fill" Stroke="{DynamicResource Violet}" StrokeThickness="2.5"
       StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
       Data="M 0,10 L 4,10 L 7,4 L 11,17 L 15,0 L 19,10 L 24,10"/>
     </Border>
     <TextBlock Text="EazyLoop" FontSize="26" FontWeight="Bold" Margin="12,0,0,0"/>
     <Border Margin="10,0,0,0" Padding="6,2" Background="{DynamicResource AccentPanel}" CornerRadius="5" VerticalAlignment="Center">
      <TextBlock Text="{DynamicResource 'loc:БЕТА 0.7.10'}" Foreground="{DynamicResource Violet}" FontWeight="SemiBold" FontSize="10"/>
     </Border>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <StackPanel Margin="0,0,10,0">
      <TextBlock Text="{DynamicResource 'loc:ОБЩИЙ МИКРОФОН'}" Style="{StaticResource Label}" Margin="1,0,0,4"/>
      <ComboBox x:Name="Microphone" Width="255" Height="32" SelectionChanged="MicrophoneChanged" DropDownOpened="RefreshMicrophones"
       DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="{DynamicResource 'loc:Микрофон'}"/>
     </StackPanel>
     <Button x:Name="SettingsButton" Width="41" Height="32" Padding="0" VerticalAlignment="Bottom"
      Click="OpenSettings" ToolTip="{DynamicResource 'loc:Настройки звука'}" AutomationProperties.Name="{DynamicResource 'loc:Настройки звука'}">
      <Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource Soft}" StrokeThickness="1.5" StrokeLineJoin="Round"
       Data="M 10,2 L 14,2 L 15,5 L 18,6 L 21,5 L 23,8 L 21,11 L 21,13 L 23,16 L 21,19 L 18,18 L 15,19 L 14,22 L 10,22 L 9,19 L 6,18 L 3,19 L 1,16 L 3,13 L 3,11 L 1,8 L 3,5 L 6,6 L 9,5 Z M 12,8 A 4,4 0 1 1 11.99,8"/>
     </Button>
    </StackPanel>
   </Grid>

   <Border Grid.Row="1" Margin="0,14,0,0" Padding="20,16,20,15" CornerRadius="15" BorderThickness="1" BorderBrush="{DynamicResource Line}">
    <Border.Background>
     <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="{DynamicResource TransportTintColor}" Offset="0"/>
      <GradientStop Color="{DynamicResource PanelColor}" Offset="0.70"/>
     </LinearGradientBrush>
    </Border.Background>
    <StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,13">
       <ToggleButton x:Name="TunerToggle" Style="{StaticResource PillToggle}" Height="24" Padding="6,0" Margin="0,0,12,0"
        ToolTip="{DynamicResource 'loc:Нажмите, чтобы развернуть или свернуть тюнер.'}"
        AutomationProperties.Name="{DynamicResource 'loc:Хроматический тюнер активного входа'}">
        <StackPanel Orientation="Horizontal">
         <Path Width="10" Height="13" Stretch="Uniform" Stroke="{DynamicResource Violet}" StrokeThickness="1.5"
          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
          Data="M 3,2 V 8 C 3,14 13,14 13,8 V 2 M 8,12.5 V 19 M 5.5,19 H 10.5"/>
         <TextBlock Text="{Binding Text, ElementName=TunerNote}" Width="27" Margin="5,0,3,0"
          FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"/>
         <local:TunerScale x:Name="CompactTunerScale" Compact="True" Width="52" Height="12"/>
         <TextBlock Text="{Binding Text, ElementName=TunerOffset}" Foreground="{Binding Foreground, ElementName=TunerOffset}"
          Width="32" Margin="4,0,0,0" TextAlignment="Right" FontFamily="Consolas" FontSize="10"/>
        </StackPanel>
       </ToggleButton>
       <TextBlock Text="{DynamicResource 'loc:ВХОД'}" Style="{StaticResource Label}" Margin="0,0,8,0"/>
       <Border Width="75" Height="6" CornerRadius="3" Background="{DynamicResource StrongLine}" ClipToBounds="True">
        <Border x:Name="Level" Width="0" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource Mint}"/>
       </Border>
     </StackPanel>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
       <Button x:Name="PlayButton" Width="44" Height="40" Padding="0" Click="PlayClicked" ToolTip="{DynamicResource 'loc:Играть'}"
        AutomationProperties.Name="{DynamicResource 'loc:Играть'}" ToolTipService.ShowOnDisabled="True"
        Background="{DynamicResource Violet}" Foreground="{DynamicResource OnAccent}" BorderBrush="{DynamicResource Violet}" IsEnabled="False">
        <Path x:Name="PlayIcon" Fill="{DynamicResource OnAccent}" Width="14" Height="14" Stretch="Uniform" Data="M 0,0 L 10,5.5 L 0,11 Z"/>
       </Button>
       <Button x:Name="RecordButton" Width="44" Height="40" Padding="0" Margin="8,0,0,0" Click="RecordClicked"
        ToolTip="{DynamicResource 'loc:Подключение звука…'}" AutomationProperties.Name="{DynamicResource 'loc:Записать'}"
        ToolTipService.ShowOnDisabled="True" Background="#C43B50" BorderBrush="#C43B50" IsEnabled="False">
        <Path x:Name="RecordIcon" Fill="White" Width="14" Height="14" Stretch="Uniform">
         <Path.Data><EllipseGeometry Center="7,7" RadiusX="7" RadiusY="7"/></Path.Data>
        </Path>
       </Button>
       <Border x:Name="TransportStatus" Width="24" Background="Transparent"
        ToolTip="{DynamicResource 'loc:ТРАНСПОРТ'}" AutomationProperties.Name="{DynamicResource 'loc:ТРАНСПОРТ'}">
        <Ellipse x:Name="StateDot" Width="6" Height="6" Fill="{DynamicResource Muted}"/>
       </Border>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
       <StackPanel Width="62">
        <TextBlock Text="{DynamicResource 'loc:ТЕМП'}" Style="{StaticResource Label}" Margin="1,0,0,4"/>
        <TextBox x:Name="Tempo" Text="100" Height="34" MaxLength="3" TextAlignment="Center" FontWeight="SemiBold"
         LostKeyboardFocus="GridChanged" KeyDown="TempoKeys" ToolTip="{DynamicResource 'loc:Темп в BPM от 40 до 240'}" AutomationProperties.Name="{DynamicResource 'loc:Темп BPM'}"/>
       </StackPanel>
       <StackPanel Margin="8,0,0,0" Width="66">
        <TextBlock Text="{DynamicResource 'loc:РАЗМЕР'}" Style="{StaticResource Label}" Margin="1,0,0,4"/>
        <ComboBox x:Name="Meter" Height="34" SelectionChanged="GridSelectionChanged" AutomationProperties.Name="{DynamicResource 'loc:Музыкальный размер'}"/>
       </StackPanel>
       <StackPanel Margin="8,0,0,0" Width="64">
        <TextBlock Text="{DynamicResource 'loc:ТАКТЫ'}" Style="{StaticResource Label}" Margin="1,0,0,4"/>
        <ComboBox x:Name="Bars" Height="34" SelectionChanged="GridSelectionChanged" AutomationProperties.Name="{DynamicResource 'loc:Длина в тактах'}"/>
       </StackPanel>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
        <ToggleButton x:Name="MetronomeButton" Style="{StaticResource IconToggle}"
         Checked="ClickToggleChanged" Unchecked="ClickToggleChanged" ToolTip="{DynamicResource 'loc:Метроном · M'}" AutomationProperties.Name="{DynamicResource 'loc:Метроном'}">
         <Path Width="17" Height="17" Stretch="Uniform" Data="M 2,15 H 14 L 11,2 H 6 Z M 8,11 L 15,4 M 2,15 H 15"
          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </ToggleButton>
        <ToggleButton x:Name="CountInButton" Style="{StaticResource IconToggle}" Margin="5,0,0,0"
         Checked="ClickToggleChanged" Unchecked="ClickToggleChanged" ToolTip="{DynamicResource 'loc:Предтакт · один такт перед записью с остановки'}" AutomationProperties.Name="{DynamicResource 'loc:Предтакт'}">
         <Path Width="17" Height="17" Stretch="Uniform" Data="M 2,4 V 12 M 6,4 V 12 M 10,4 L 16,8 L 10,12 Z"
          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </ToggleButton>
        <ToggleButton x:Name="ClickVolumeButton" Style="{StaticResource IconToggle}" Margin="5,0,0,0"
         ToolTip="{DynamicResource 'loc:Громкость метронома и предтакта'}" AutomationProperties.Name="{DynamicResource 'loc:Громкость клика'}">
         <Path Width="18" Height="17" Stretch="Uniform" Data="M 1,6 H 4 L 8,3 V 13 L 4,10 H 1 Z M 11,6 C 13,7 13,9 11,10 M 14,4 C 17,6 17,10 14,12"
          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </ToggleButton>
        <Popup x:Name="ClickVolumePopup" PlacementTarget="{Binding ElementName=ClickVolumeButton}" Placement="Bottom"
         AllowsTransparency="True" StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=ClickVolumeButton, Mode=TwoWay}">
         <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" Padding="12,8" Margin="0,4,0,0" Width="188">
          <StackPanel>
           <DockPanel>
            <TextBlock x:Name="ClickVolumeValue" DockPanel.Dock="Right" Text="100%" Foreground="{DynamicResource Soft}" FontSize="11"/>
            <TextBlock Text="{DynamicResource 'loc:ГРОМКОСТЬ КЛИКА'}" Style="{StaticResource Label}"/>
           </DockPanel>
           <Slider x:Name="ClickVolume" Minimum="0" Maximum="100" Value="100" SmallChange="1" LargeChange="10"
            ValueChanged="ClickVolumeChanged" AutomationProperties.Name="{DynamicResource 'loc:Громкость клика'}"/>
          </StackPanel>
         </Border>
        </Popup>
       </StackPanel>
      </StackPanel>
     </Grid>
     <local:LoopStrip x:Name="Ruler" IsRuler="True" Height="38" Margin="0,16,0,0" Cursor="Hand" ClipToBounds="True"
      ToolTip="{DynamicResource 'loc:Щёлкните или тяните по линейке, чтобы выбрать позицию. Правый щелчок возвращает в начало. Переход во время записи завершает дубль.'}"
      AutomationProperties.Name="{DynamicResource 'loc:Позиция воспроизведения'}"/>
     <Grid Margin="0,9,0,0">
      <TextBlock x:Name="LengthLabel" Text="{DynamicResource 'loc:2 такта · 4,80 с'}" FontSize="12" Foreground="{DynamicResource Soft}"/>
      <TextBlock x:Name="PositionLabel" Text="01 / 01" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource Violet}" HorizontalAlignment="Right"/>
     </Grid>
     <Border x:Name="ExpandedTuner" Margin="0,12,0,0" Padding="12,6" CornerRadius="9" Background="{DynamicResource Surface}"
      BorderBrush="{DynamicResource Line}" BorderThickness="1"
      ToolTip="{DynamicResource 'loc:Хроматический тюнер активного входа'}"
      AutomationProperties.Name="{DynamicResource 'loc:Хроматический тюнер активного входа'}">
      <Border.Style>
       <Style TargetType="Border">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding IsChecked, ElementName=TunerToggle}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </Border.Style>
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="106"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/>
       </Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
        <Path Width="17" Height="20" Stretch="Uniform" Stroke="{DynamicResource Violet}" StrokeThickness="1.6"
         StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
         Data="M 3,2 V 8 C 3,14 13,14 13,8 V 2 M 8,12.5 V 19 M 5.5,19 H 10.5"/>
        <StackPanel Margin="8,0,0,0">
         <TextBlock Text="{DynamicResource 'loc:ТЮНЕР'}" Style="{StaticResource Label}"/>
         <TextBlock Text="{DynamicResource 'loc:A4 = 440 Гц'}" Foreground="{DynamicResource Muted}" FontSize="11"/>
        </StackPanel>
       </StackPanel>
       <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="TunerNote" Text="—" FontSize="24" FontWeight="SemiBold" LineHeight="26"/>
        <TextBlock x:Name="TunerHertz" Text="—" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Soft}"/>
       </StackPanel>
       <StackPanel Grid.Column="2" VerticalAlignment="Center">
        <local:TunerScale x:Name="TunerScaleView" Height="23"/>
        <Grid Margin="3,2,3,0">
         <TextBlock Text="−50" HorizontalAlignment="Left" Foreground="{DynamicResource Muted}" FontSize="10"/>
         <TextBlock Text="0" HorizontalAlignment="Center" Foreground="{DynamicResource Mint}" FontSize="10"/>
         <TextBlock Text="+50" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="10"/>
        </Grid>
       </StackPanel>
       <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0,0,0">
        <TextBlock x:Name="TunerOffset" Text="—" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="17" Foreground="{DynamicResource Muted}"/>
        <TextBlock x:Name="TunerStatus" Text="{DynamicResource 'loc:Жду ноту'}" HorizontalAlignment="Right"
         FontSize="11" Foreground="{DynamicResource Soft}" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
      </Grid>
     </Border>
    </StackPanel>
   </Border>

   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
     <TextBlock Text="{DynamicResource 'loc:Дорожки'}" FontSize="21" FontWeight="SemiBold"/>
     <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="9,0,0,0" VerticalAlignment="Center">
      <TextBlock x:Name="TrackCount" Text="01" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource Soft}"/>
     </Border>
     <TextBlock Text="{DynamicResource 'loc:За волну — сдвиг · Alt+колесо — масштаб'}" Margin="14,2,0,0" FontSize="12" Foreground="{DynamicResource Muted}"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
     <Button x:Name="AddSimpleButton" Click="AddSimpleClicked" ToolTip="{DynamicResource 'loc:Встроенные инструменты'}"
      AutomationProperties.Name="{DynamicResource 'loc:Добавить встроенный инструмент'}">
      <Button.ContextMenu>
       <ContextMenu Placement="Bottom" Foreground="{DynamicResource Ink}">
        <ContextMenu.Template>
         <ControlTemplate TargetType="ContextMenu">
          <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource StrongLine}" BorderThickness="1" CornerRadius="8" Padding="4">
           <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
          </Border>
         </ControlTemplate>
        </ContextMenu.Template>
        <ContextMenu.ItemContainerStyle>
         <Style TargetType="MenuItem">
          <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
          <Setter Property="Template">
           <Setter.Value>
            <ControlTemplate TargetType="MenuItem">
             <Border x:Name="Item" Background="Transparent" CornerRadius="5" Padding="10,7" MinWidth="135">
              <ContentPresenter ContentSource="Header"/>
             </Border>
             <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource AccentPanel}"/></Trigger>
             </ControlTemplate.Triggers>
            </ControlTemplate>
           </Setter.Value>
          </Setter>
         </Style>
        </ContextMenu.ItemContainerStyle>
        <MenuItem Header="SimpleSynth" Click="AddSynthClicked" ToolTip="{DynamicResource 'loc:Встроенный синтезатор'}"/>
        <MenuItem Header="Glissando Synth" Click="AddGlissandoClicked" ToolTip="{DynamicResource 'loc:Открыть редактор глиссандо'}"/>
        <MenuItem Header="SimpleDrums" Click="AddDrumsClicked" ToolTip="{DynamicResource 'loc:Ударные и пошаговый редактор'}"/>
       </ContextMenu>
      </Button.ContextMenu>
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="+ Simple"/>
       <Path Data="M 0,0 L 3,3 L 6,0" Stroke="{DynamicResource Soft}" StrokeThickness="1.5"
        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="7,1,0,0"/>
      </StackPanel>
     </Button>
     <Button x:Name="AddInstrumentButton" Click="AddInstrumentClicked" Content="{DynamicResource 'loc:+ Инструмент'}" ToolTip="{DynamicResource 'loc:Внешний VST3-инструмент'}" Margin="6,0,0,0"/>
     <Button x:Name="AddButton" Click="AddClicked" Content="{DynamicResource 'loc:+ Дорожка'}" ToolTip="{DynamicResource 'loc:Аудиодорожка · Ctrl+T'}" Margin="6,0,0,0"/>
    </StackPanel>
   </Grid>

   <ScrollViewer x:Name="TrackScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
    AllowDrop="True" DragOver="TrackDragOver" DragLeave="TrackDragLeave" Drop="TrackDrop">
    <StackPanel x:Name="TrackList" Background="Transparent"/>
   </ScrollViewer>

   <Grid Grid.Row="4">
    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}"/>
    <TextBlock x:Name="TransportKeysHint" Text="{DynamicResource 'loc:Пробел  Играть / Стоп       R / Ctrl+Space  Запись       M  Метроном       Ctrl+T  Дорожка'}"
     FontSize="12" Foreground="{DynamicResource Muted}"/>
    <TextBlock x:Name="AudioHint" Text="{DynamicResource 'loc:Подключение звука…'}" FontSize="12" Foreground="{DynamicResource Soft}" HorizontalAlignment="Right" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
   </Grid>
  </Grid>
  </DockPanel>

  <Grid x:Name="SettingsOverlay" Background="#A30A0A12" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
   <Border Width="444" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource Panel}"
    BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" CornerRadius="16">
    <StackPanel>
     <Grid>
      <TextBlock Text="{DynamicResource 'loc:Настройки звука'}" FontWeight="SemiBold" FontSize="22"/>
      <Button Content="×" Width="34" HorizontalAlignment="Right" Click="CloseSettings" AutomationProperties.Name="{DynamicResource 'loc:Закрыть настройки'}"/>
     </Grid>
     <TextBlock Text="{DynamicResource 'loc:Микрофон выбирается в главном окне.'}" Foreground="{DynamicResource Soft}" FontSize="13" Margin="0,4,0,17"/>
     <TextBlock Text="{DynamicResource 'loc:ДРАЙВЕР'}" Style="{StaticResource Label}" Margin="0,0,0,5"/>
     <ComboBox x:Name="DriverList" Height="35" SelectionChanged="DraftDriverChanged" AutomationProperties.Name="{DynamicResource 'loc:Драйвер'}">
      <ComboBoxItem Content="{DynamicResource 'loc:WASAPI · общий режим'}"/><ComboBoxItem Content="{DynamicResource 'loc:MME · совместимость'}"/>
     </ComboBox>
     <TextBlock Text="{DynamicResource 'loc:ВЫХОД'}" Style="{StaticResource Label}" Margin="0,15,0,5"/>
     <ComboBox x:Name="OutputList" Height="35" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="{DynamicResource 'loc:Устройство вывода'}"/>
     <TextBlock Text="{DynamicResource 'loc:БУФЕР'}" Style="{StaticResource Label}" Margin="0,15,0,5"/>
     <ComboBox x:Name="BufferList" Height="35" DisplayMemberPath="Name" SelectedValuePath="Value" SelectionChanged="RecordingCompensationChanged"
      AutomationProperties.Name="{DynamicResource 'loc:Размер буфера'}"/>
     <TextBlock Text="{DynamicResource 'loc:При треске или пропусках увеличьте буфер.'}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,9,0,0"/>
     <TextBlock Text="{DynamicResource 'loc:КОМПЕНСАЦИЯ ЗАПИСИ, МС'}" Style="{StaticResource Label}" Margin="0,15,0,5"/>
     <DockPanel>
      <ToggleButton x:Name="CompensationAuto" DockPanel.Dock="Right" Style="{StaticResource PillToggle}" Margin="8,0,0,0"
       Height="35" Content="{DynamicResource 'loc:Авто'}" IsChecked="True" Checked="RecordingCompensationChanged" Unchecked="RecordingCompensationChanged"/>
      <TextBox x:Name="CompensationValue" Height="35" MaxLength="9" Text="0" IsReadOnly="True"
       AutomationProperties.Name="{DynamicResource 'loc:Компенсация записи в миллисекундах'}"/>
     </DockPanel>
     <TextBlock x:Name="CompensationHint" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,21,0,0">
      <Button Content="{DynamicResource 'loc:Отмена'}" Width="88" Click="CloseSettings"/>
      <Button Width="106" Margin="8,0,0,0" Background="{DynamicResource Violet}" BorderBrush="{DynamicResource Violet}" Click="ApplySettings">
       <TextBlock Text="{DynamicResource 'loc:Применить'}" Foreground="{DynamicResource OnAccent}"/>
      </Button>
     </StackPanel>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
