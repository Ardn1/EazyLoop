<Window x:Class="EazyLoop.AudioEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:EazyLoop"
 Width="1020" Height="620" MinWidth="750" MinHeight="440" ShowInTaskbar="False"
 WindowStartupLocation="CenterOwner" UseLayoutRounding="True" FontFamily="Segoe UI" FontSize="13"
 Background="{DynamicResource Background}" Foreground="{DynamicResource Ink}" PreviewKeyDown="WindowKeys">
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <Button DockPanel.Dock="Right" Content="{DynamicResource 'loc:Сохранить проект'}" Click="SaveClicked" ToolTip="Ctrl+S"/>
   <Border DockPanel.Dock="Left" Width="41" Height="39" CornerRadius="9" Background="{DynamicResource AccentPanel}" Margin="0,0,11,0">
    <Path Stroke="{DynamicResource Violet}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round"
     StrokeEndLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Center" Data="M 0,9 H 4 L 7,3 L 10,15 L 13,5 L 16,10 H 21"/>
   </Border>
   <StackPanel>
    <TextBlock x:Name="TrackLabel" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="{DynamicResource 'loc:Редактор аудио'}" Foreground="{DynamicResource Muted}" FontSize="11"/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
   CornerRadius="9" Padding="9,7" Margin="0,0,0,8">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="{DynamicResource 'loc:ВОЛНА'}" Style="{StaticResource Label}" Margin="0,0,6,0"/>
     <Slider x:Name="WaveZoom" Minimum="0" Maximum="6" Value="0" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True"
      Width="82" ValueChanged="WaveZoomChanged" ToolTip="{DynamicResource 'loc:Высота волны · Alt+колесо'}"
      AutomationProperties.Name="{DynamicResource 'loc:Масштаб волны'}"/>
     <TextBlock x:Name="WaveZoomValue" Text="1×" Width="29" Margin="4,0,12,0" VerticalAlignment="Center"
      Foreground="{DynamicResource Soft}" FontSize="11" FontFamily="Consolas"/>
     <TextBlock Text="{DynamicResource 'loc:МАСШТАБ'}" Style="{StaticResource Label}" Margin="0,0,6,0"/>
     <Slider x:Name="Zoom" Minimum="0" Maximum="6" Value="0" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True"
      Width="82" ValueChanged="ZoomChanged" AutomationProperties.Name="{DynamicResource 'loc:МАСШТАБ'}"/>
    </StackPanel>
    <WrapPanel VerticalAlignment="Center">
     <Button x:Name="PlayButton" Style="{StaticResource Compact}" MinWidth="79" Content="{DynamicResource 'loc:▶ Играть'}" Click="PlayClicked"/>
     <Button x:Name="UndoButton" Style="{StaticResource HistoryButton}" Content="1" Margin="10,0,0,0" Click="UndoClicked"
      ToolTip="{DynamicResource 'loc:Отменить · Ctrl+Z'}" AutomationProperties.Name="{DynamicResource 'loc:Отменить'}"/>
     <Button x:Name="RedoButton" Style="{StaticResource HistoryButton}" Content="-1" Margin="4,0,0,0" Click="RedoClicked"
      ToolTip="{DynamicResource 'loc:Повторить · Ctrl+Y или Ctrl+Shift+Z'}" AutomationProperties.Name="{DynamicResource 'loc:Повторить'}"/>
     <RadioButton x:Name="MoveTool" Style="{StaticResource PillToggle}" Height="27" Padding="8,0" FontSize="12" GroupName="AudioTools" IsChecked="True" Margin="12,0,5,0" VerticalAlignment="Center"
      Content="{DynamicResource 'loc:Перемещать'}" Checked="ToolChanged"/>
     <RadioButton x:Name="CutTool" Style="{StaticResource PillToggle}" Height="27" Padding="8,0" FontSize="12" GroupName="AudioTools" Margin="0,0,9,0" VerticalAlignment="Center"
      Content="{DynamicResource 'loc:Разрезать'}" Checked="ToolChanged" ToolTip="{DynamicResource 'loc:Разрезать фрагмент · C'}"/>
     <CheckBox x:Name="Snap" Style="{StaticResource PillToggle}" Height="27" Padding="8,0" FontSize="12" VerticalAlignment="Center" Content="{DynamicResource 'loc:Сетка 1/16'}" Checked="SnapChanged" Unchecked="SnapChanged"/>
     <Button x:Name="DeleteButton" Style="{StaticResource Compact}" Margin="9,0,0,0" Content="{DynamicResource 'loc:Удалить'}"
      ToolTip="{DynamicResource 'loc:Удалить выбранный фрагмент или точку · Delete'}" Click="DeleteClicked"/>
    </WrapPanel>
   </DockPanel>
  </Border>
  <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
   CornerRadius="9" ClipToBounds="True">
   <local:AudioEditSurface x:Name="Timeline" Focusable="True" AutomationProperties.Name="{DynamicResource 'loc:Фрагменты'}"/>
  </Border>
  <Slider x:Name="Scroll" Grid.Row="3" Minimum="0" Maximum="0" Visibility="Collapsed" Margin="81,3,0,0"
   ValueChanged="ScrollChanged" AutomationProperties.Name="{DynamicResource 'loc:Прокрутка по времени'}"/>
  <DockPanel Grid.Row="4" Margin="0,10,0,0">
   <TextBlock x:Name="SelectionLabel" DockPanel.Dock="Right" Margin="12,0,0,0" FontSize="11" Foreground="{DynamicResource Violet}"/>
   <TextBlock FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
    Text="{DynamicResource 'loc:Щелчок по полосе громкости добавляет точку. Перетаскивайте точки и фрагменты.'}"/>
  </DockPanel>
 </Grid>
</Window>
