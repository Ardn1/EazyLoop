<Window x:Class="EazyLoop.ThemeEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource 'loc:Своя тема'}" Width="470" SizeToContent="Height" ResizeMode="NoResize"
 ShowInTaskbar="False" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13"
 Background="{DynamicResource Background}" Foreground="{DynamicResource Ink}">
 <StackPanel Margin="22">
  <TextBlock Text="{DynamicResource 'loc:Своя тема'}" FontSize="22" FontWeight="SemiBold"/>
  <TextBlock Text="{DynamicResource 'loc:Цвета видны сразу. Сохраните тему, чтобы добавить её в список.'}"
   TextWrapping="Wrap" Foreground="{DynamicResource Soft}" Margin="0,5,0,16"/>
  <TextBlock Text="{DynamicResource 'loc:Название темы'}" Style="{StaticResource Label}" Margin="0,0,0,5"/>
  <TextBox x:Name="ThemeName" Height="34" MaxLength="48" TextChanged="NameChanged"
   AutomationProperties.Name="{DynamicResource 'loc:Название темы'}"/>
  <TextBlock Text="{DynamicResource 'loc:Цвет интерфейса'}" Style="{StaticResource Label}" Margin="0,13,0,5"/>
  <ItemsControl x:Name="PaletteRows" AutomationProperties.Name="{DynamicResource 'loc:Цвет интерфейса'}">
   <ItemsControl.ItemTemplate>
    <DataTemplate>
     <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
      CornerRadius="8" Padding="11,4,5,4" Margin="0,0,0,4" AllowDrop="True"
      DragEnter="ColorDragOver" DragOver="ColorDragOver" DragLeave="ColorDragLeave" Drop="ColorDropped">
      <DockPanel>
       <Button DockPanel.Dock="Right" Width="119" Height="30" Style="{StaticResource Compact}"
        Click="ColorClicked" PreviewMouseLeftButtonDown="ColorPressed" PreviewMouseMove="ColorMoved"
        AutomationProperties.Name="{Binding Label}" ToolTip="{DynamicResource 'loc:Открыть палитру или перетащить цвет на другую строку.'}">
        <StackPanel Orientation="Horizontal">
         <Border Width="29" Height="17" CornerRadius="4" BorderThickness="1" Margin="0,0,8,0"
          Background="{Binding Brush}" BorderBrush="{DynamicResource StrongLine}"/>
         <TextBlock Text="{Binding Hex}" FontFamily="Consolas" FontSize="12"/>
        </StackPanel>
       </Button>
       <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
      </DockPanel>
     </Border>
    </DataTemplate>
   </ItemsControl.ItemTemplate>
  </ItemsControl>
  <TextBlock Text="{DynamicResource 'loc:Перетащите цвет, чтобы скопировать. С Shift цвета меняются местами.'}"
   TextWrapping="Wrap" Foreground="{DynamicResource Soft}" FontSize="11" Margin="1,4,0,0"/>
  <TextBlock x:Name="Validation" TextWrapping="Wrap" MinHeight="32" Margin="0,7,0,0"
   Foreground="{DynamicResource Rose}" FontSize="12" VerticalAlignment="Top"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
   <Button IsCancel="True" Content="{DynamicResource 'loc:Отмена'}"/>
   <Button x:Name="SaveButton" Click="SaveClicked" IsDefault="True" Margin="8,0,0,0"
    Background="{DynamicResource Violet}" BorderBrush="{DynamicResource Violet}">
    <TextBlock Text="{DynamicResource 'loc:Сохранить тему'}" Foreground="{DynamicResource OnAccent}"/>
   </Button>
  </StackPanel>
 </StackPanel>
</Window>
